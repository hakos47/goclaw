# =============================================================================
# GoClaw .gitignore — exhaustive, security-first
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Secrets & Credentials
# -----------------------------------------------------------------------------
.env*
!.env.example
*.env
secrets/
credentials/
cred.json
creds.json
passwd
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
ssh/

# -----------------------------------------------------------------------------
# 2. Environment & Local Config
# -----------------------------------------------------------------------------
.env.local
.env.production
.env.development
.env.test
.env.staging
config.json
config.local.json
configoverride.json
*/config.local.json
*/config.local.yml
*.local.yaml
*.local.yml
*.local.toml
configs/local/
runtime_config.json

# -----------------------------------------------------------------------------
# 3. Database Files
# -----------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
goclaw.db
goclaw.db-*
goclaw.db-wal
goclaw.db-shm
goclaw.sqlite
goclaw.sqlite-*
.sqlite.db
pgdata/

# -----------------------------------------------------------------------------
# 4. Runtime, Data & State
# -----------------------------------------------------------------------------
# Default data directory (desktop edition)
data/
*.goclaw/
.goclaw/
.goclaw/data/
.goclaw/logs/
.goclaw/secrets/
.goclaw/workspace/
.goclaw/cache/

# Skills and workspace (user-specific, may contain secrets)
skills-store/
skills-store
/.goclaw/data/skills-store
/workspace/
workspace/
team-workspace/
teams/

# WhatsApp / Channel runtime state
wa-session.json
whatsapp-session.json
whatsapp-auth.json
whatsmeow-store.json
whatsmeow-store/
*/wa-store/
*/whatsapp-store/
*.wa

# Desktop edition secrets (OS keyring fallback)
.goclaw/secrets/

# Logs
*.log
logs/
*.logs
*.trace
debug.log
error.log

# -----------------------------------------------------------------------------
# 5. Binaries & Build Artifacts
# -----------------------------------------------------------------------------
goclaw
openclaw-go
pkg-helper
app
browser-poc
goclaw-*
goclaw_*
*.exe
*.exe.bak
*.app.bak
*.bin
goclaw-patched-*
goclaw-lite
goclaw-lite-*.dmg
goclaw-lite-*.tar.gz
goclaw-lite-*.zip
goclaw-desktop
*.app
*.dmg
*.pkg
*.msi
*.deb
*.rpm

# UI Desktop
ui/desktop/build/bin/
ui/desktop/build/
ui/desktop/desktop
ui/desktop/main
ui/desktop/goclaw-lite
ui/desktop/goclaw-desktop
/desktop

# Build output (React/Vite)
ui/web/dist/
ui/web/.vite/
ui/web/node_modules/
ui/web/package.json.md5
ui/web/src/i18n/generated/
ui/desktop/frontend/dist/
ui/desktop/frontend/.vite/
ui/desktop/frontend/node_modules/
ui/desktop/frontend/wailsjs/
ui/desktop/frontend/package.json.md5

# Version file (auto-generated by Makefile)
/VERSION
ui/desktop/frontend/dist/index.html

# -----------------------------------------------------------------------------
# 6. Temporary, Cache & Intermediates
# -----------------------------------------------------------------------------
tmp/
tmp
*.tmp
*.temp
*.swp
*.swo
*~
.#*
\#*\#
.*.swp
.cache/
.cache
__pycache__/
__pycache__
*.pyc
*.pyo
*.pycache
.pytest_cache/
.pytest_cache
node_modules/
node_modules
.bun/
.bun
.pnpm-store/
pnpm-store/
.cache/
.astro/
.nuxt/
.next/
.next
.vite/
vite/
.rollup.cache/
.rollup.cache
.rollup/

# Claude Code artifacts
.claude/
.claude/plans/
.claude/tasks/
.claude/scheduled_tasks.json
.mcp.json

# -----------------------------------------------------------------------------
# 7. IDE & Editor
# -----------------------------------------------------------------------------
.idea/
.vscode/
.vscode/
*.sublime-workspace
*.sublime-project
.emacs.d/
.spacemacs
vim/
.nvim/
*.code-workspace
*.code-snippets
.obsidian/

# -----------------------------------------------------------------------------
# 8. OS & Finder
# -----------------------------------------------------------------------------
.DS_Store
._*
.Thumbnails/
.Trashes/
ehthumbs.db
Desktop.ini
desktop.ini
.Directory

# -----------------------------------------------------------------------------
# 9. Test & QA Artifacts
# -----------------------------------------------------------------------------
tests/integration/testdata/
testdata/
test-output/
coverage.out
coverage/
*.coverprofile
*.test
tests/output/
tests/creds.json
ui/simple-saas

# -----------------------------------------------------------------------------
# 10. Deployment & Infra
# -----------------------------------------------------------------------------
deploy-*.sh
k8s-*/
kubernetes/
*.yaml.tpl
docker-compose.override*
docker/.env
*.backup
*.bak
*.old
*.orig

# Compose modules
compose.d/*
!compose.d/.gitkeep
!compose.d/0*

# Mise-en-place
/.miserc.toml
/mise.*.toml
/mise
/.mise

# AppArmor (runtime-generated on Linux)
apparmor.d/
security/

# -----------------------------------------------------------------------------
# 11. Networking & VPN
# -----------------------------------------------------------------------------
wireguard/
wg*.conf
cloudflared/
tailscale/
openvpn/
nginx*.conf.bak

# -----------------------------------------------------------------------------
# 12. AI Tooling & User-Specific Config
# -----------------------------------------------------------------------------
.gemini/
.opencode/
cursor/
windsurf/
augment/
aider.conf
llm-cost-summary.json
llm-usage*.json
usage-*.json
prompt-cache/

# Claude / Anthropic local config
.config/
.config/claude/

# Cursor / Windsurf rule files
.cursor/
.windsurf/

# -----------------------------------------------------------------------------
# 13. Docs, Plans & Internal
# -----------------------------------------------------------------------------
docs/technical-diaries/
docs/zuey/
plans/
release-manifest.json
*.draft
*_draft.*
internal-drafts/

# Personal notes (may contain secrets)
_notes/
private/
personal/
memo/
memos/

# -----------------------------------------------------------------------------
# 14. Misc
# -----------------------------------------------------------------------------
*.tar
*.gz
*.bz2
*.xz
*.zip
*.7z
*.rar
*.part
.RECYCLE_BIN/
$RECYCLE.BIN/
System Volume Information/

# -----------------------------------------------------------------------------
# 15. TypeScript / Build Info (TSBuildInfo for incremental builds)
# -----------------------------------------------------------------------------
*.tsbuildinfo
*.jsbuildinfo
ui/web/tsconfig.tsbuildinfo
ui/web/tsconfig.*.tsbuildinfo

# -----------------------------------------------------------------------------
# 16. Local Scripts
# -----------------------------------------------------------------------------
run.sh
scripts/local/
local/
*.local.sh
setup-local.sh
dev-start.sh
start-local.sh
